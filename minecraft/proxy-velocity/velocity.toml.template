# Plantilla de Velocity. gen-mc-config rellena la seccion [servers] segun el modo
# (lean = solo main; full = lobby + main) y escribe minecraft/.generated/velocity/velocity.toml.
# NO contiene el secreto: el modern forwarding lo lee de forwarding.secret.
config-version = "2.7"

# Unico punto de entrada de la red (ADR-0005). Java entra por aqui.
bind = "0.0.0.0:25565"
motd = "<#00aaff>Aetheria</#00aaff> - civilizacion viva"
show-max-players = 100
online-mode = true
force-key-authentication = true
prevent-client-proxy-connections = false

# Modern forwarding: el secreto vive en un fichero aparte (mismo valor en Paper).
player-info-forwarding-mode = "modern"
forwarding-secret-file = "forwarding.secret"

announce-forge = false
kick-existing-players = false
ping-passthrough = "DISABLED"

[servers]
# Los nombres resuelven por la red de docker-compose (nombre de servicio).
%%SERVERS%%
# A donde va el jugador al conectar.
try = %%TRY%%

[forced-hosts]

[advanced]
compression-threshold = 256
compression-level = -1
login-ratelimit = 3000
connection-timeout = 5000
read-timeout = 30000

[query]
enabled = false
