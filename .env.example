# ============================================================
# Aetheria AI - Variables de entorno (plantilla)
# Copia a .env y rellena. NUNCA subas .env al repositorio.
# ============================================================

# --- Entorno ---
AETHERIA_ENV=dev            # dev | staging | prod
LOG_LEVEL=INFO

# --- API Gateway ---
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
# Token compartido Plugin <-> API Gateway (autenticacion servicio-a-servicio)
INTERNAL_SERVICE_TOKEN=changeme-generate-a-long-random-secret

# --- AI Orchestrator ---
AI_ORCHESTRATOR_HOST=0.0.0.0
AI_ORCHESTRATOR_PORT=8090
# URL que usa el API Gateway para alcanzar al orchestrator (nombre de servicio Docker)
AI_ORCHESTRATOR_URL=http://ai-orchestrator:8090

# --- Nivel 3: razonamiento (planner) ---
#   stub   = respuestas simuladas, coste CERO (por defecto)
#   ollama = IA real y GRATIS, modelo local en tu maquina (ver ADR-0009)
#   claude = IA real DE PAGO (requiere ANTHROPIC_API_KEY)
LLM_PROVIDER=stub
# Con LLM_PROVIDER=ollama pon aqui un modelo local. Recomendado: qwen3:8b
# (modelo de RAZONAMIENTO: acierta mas generando el JSON del plan).
LLM_MODEL_L3=claude-sonnet-4-6

# --- Nivel 2: charla normal con NPC (ADR-0007: NUNCA gasta) ---
# Solo admite proveedores gratuitos: stub | ollama. 'claude' se rechaza por codigo.
# Recomendado gemma3:4b (INSTRUCT puro): rapido y no divaga. NO uses qwen3 aqui.
LLM_LOCAL_PROVIDER=stub
LLM_MODEL_L2=gemma3:4b

# --- Servidor LLM local, compatible OpenAI (Ollama, LM Studio, vLLM...) ---
# Desde Docker, 'localhost' es el propio contenedor: hay que usar host.docker.internal.
# Fuera de Docker (tests, ejecucion directa) usa http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_S=120

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- PostgreSQL local (equivalente a Supabase en dev; mismas migraciones) ---
POSTGRES_USER=aetheria
POSTGRES_PASSWORD=aetheria-local-dev
POSTGRES_DB=aetheria
# Cadena para herramientas del HOST (psql local). En Docker cada servicio usa 'postgres'.
DATABASE_URL=postgresql://aetheria:aetheria-local-dev@localhost:5432/aetheria

# --- World-State ---
WORLD_STATE_URL=http://world-state:8070

# --- Supabase (produccion; se rellena en Fase 4) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Minecraft / red (Fase 1) ---
# Version de Minecraft para Paper y Velocity (pinada para reproducibilidad).
MINECRAFT_VERSION=1.21.4
# Secreto de modern forwarding (compartido Velocity <-> Paper). NUNCA en git.
VELOCITY_FORWARDING_SECRET=changeme-velocity-modern-forwarding-secret
# Autenticacion de Velocity (unico punto de entrada Java).
#   true  = premium: se valida la cuenta contra Mojang/Microsoft. VALOR NORMAL.
#   false = offline: entra cualquiera con cualquier nick (TLauncher sin cuenta).
#           Solo para pruebas en LAN. Con false, cualquiera puede suplantarte,
#           y los UUID son otros: saldo/casas/parcelas NO se comparten con premium.
VELOCITY_ONLINE_MODE=true
# Puertos expuestos al exterior (unico punto de entrada = Velocity).
VELOCITY_PORT=25565          # Java
GEYSER_BEDROCK_PORT=19132    # Bedrock (UDP)
# Memoria por servidor Paper (arranque sin lobby: solo MAIN_MEMORY tiene efecto).
# En 2 nucleos, 4G es el punto dulce para 'main'; no subir a 8G (peores pausas de GC).
MAIN_MEMORY=4G
LOBBY_MEMORY=1G
CREATIVE_MEMORY=2G
# Compat: usado por el servicio 'lobby' si se reactiva con la variable antigua.
PAPER_MEMORY=2G